import Base
import ../../geometry.bend as G
import ../../topology.bend as T
import ./wire/wire.bend as X
import ./wire-spec.bend as WS

# Round-trip lemmas for the codec generated by scripts/native-bridge/gen-wire.mjs
# (kernel/laws/spike/wire/wire.bend; regenerate, never edit). Stated
# {replacement == form-in-goal} for use with `%e : P`.

def coedge_step(y: T.Coedge, +ok: Bool, +rest: List<&2, U32>) ->
  {(y, X.Cursor{ok, rest}) == X.dec_topology_Coedge(X.Cursor{ok, X.enc_topology_Coedge(y, rest)}) : T.Coedge & X.Cursor}:
  match y:
    case T.Use{e, True{}}:
      {==}
    case T.Use{e, False{}}:
      {==}

def edge_step(y: T.Edge, +ok: Bool, +rest: List<&2, U32>) ->
  {(y, X.Cursor{ok, rest}) == X.dec_topology_Edge(X.Cursor{ok, X.enc_topology_Edge(y, rest)}) : T.Edge & X.Cursor}:
  match y:
    case T.Edge{s, t}:
      {==}

# F32 crosses as F32.bits, a Base postulate (no def): f32_of_bits(F32.bits(x))
# == x is not provable in Bend, even for x = F32{w}. It is an assumption about
# the runtimes (C, JS), taken per vector as `h`. A single `@x: F32 -> {..}`
# hypothesis does not work: rewrite evidence is live and a closure is affine,
# so it could be applied only once (and an erased one cannot be applied).
def vec3_step(v: G.Vec3, h: {WS.bits_id(v) == v : G.Vec3}, +ok: Bool, +rest: List<&2, U32>) ->
  {(v, X.Cursor{ok, rest}) == X.dec_geometry_Vec3(X.Cursor{ok, X.enc_geometry_Vec3(v, rest)}) : G.Vec3 & X.Cursor}:
  match v:
    case G.V3{x, y, z}:
      %h : {(_, X.Cursor{ok, rest}) == X.dec_geometry_Vec3(X.Cursor{ok, X.enc_geometry_Vec3(G.V3{x, y, z}, rest)}) : G.Vec3 & X.Cursor}
      {==}

# The accumulator loop of the generated list decoder.
def coedges_go(xt: List<&2, T.Coedge>, +x: T.Coedge, +ok: Bool, +rest: List<&2, U32>, +acc: List<&2, T.Coedge>) ->
  {(List.reverse.go(&2, T.Coedge, acc, x <> xt), X.Cursor{ok, rest})
    == X.dec_items_topology_Coedge_go(List.length(&2, T.Coedge, xt), (x, X.Cursor{ok, X.enc_items_topology_Coedge(xt, rest)}), acc)
    : List<&2, T.Coedge> & X.Cursor}:
  match xt:
    case Nil{}:
      {==}
    case +y <> +yt:
      %coedge_step(y, ok, X.enc_items_topology_Coedge(yt, rest)) :
        {(List.reverse.go(&2, T.Coedge, acc, x <> y <> yt), X.Cursor{ok, rest})
          == X.dec_items_topology_Coedge_go(List.length(&2, T.Coedge, yt), _, x <> acc) : List<&2, T.Coedge> & X.Cursor}
      coedges_go(yt, y, ok, rest, x <> acc)

def coedges_items(xs: List<&2, T.Coedge>, +ok: Bool, +rest: List<&2, U32>) ->
  {(xs, X.Cursor{ok, rest})
    == X.dec_items_topology_Coedge(List.length(&2, T.Coedge, xs), X.Cursor{ok, X.enc_items_topology_Coedge(xs, rest)})
    : List<&2, T.Coedge> & X.Cursor}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +xt:
      %coedge_step(x, ok, X.enc_items_topology_Coedge(xt, rest)) :
        {(x <> xt, X.Cursor{ok, rest}) == X.dec_items_topology_Coedge_go(List.length(&2, T.Coedge, xt), _, Nil{})
          : List<&2, T.Coedge> & X.Cursor}
      coedges_go(xt, x, ok, rest, Nil{})

# The count word is U32.from_nat(length): the list survives only if its length
# does (length < 2^32). That bound cannot be written as a Nat in a law (see
# LAWS.bend), so the lemma takes the count round trip itself as `pre`.
def coedges_list(+xs: List<&2, T.Coedge>, +ok: Bool, +rest: List<&2, U32>,
  pre: {U32.to_nat(U32.from_nat(List.length(&2, T.Coedge, xs))) == List.length(&2, T.Coedge, xs) : Nat}) ->
  {(xs, X.Cursor{ok, rest}) == X.dec_L_topology_Coedge(X.Cursor{ok, X.enc_L_topology_Coedge(xs, rest)}) : List<&2, T.Coedge> & X.Cursor}:
  -n = List.length(&2, T.Coedge, xs)
  %Equal.sym(Nat, U32.to_nat(U32.from_nat(n)), n, pre) :
    {(xs, X.Cursor{ok, rest}) == X.dec_items_topology_Coedge(_, X.Cursor{ok, X.enc_items_topology_Coedge(xs, rest)})
      : List<&2, T.Coedge> & X.Cursor}
  coedges_items(xs, ok, rest)
