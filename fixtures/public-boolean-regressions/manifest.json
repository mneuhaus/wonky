        "viewCheck": "Not executed: DRAW checkview screenshot, display framing and image output are outside this numeric adaptation."
      },
      "expected": {
        "solids": 1,
        "volumeMm3": 0.5,
        "areaMm2": 4.414213562373095,
        "boundsMm": {
          "min": [
            0,
            0,
            0
          ],
          "max": [
            1,
            1,
            1
          ]
        },
        "volumeAbsoluteToleranceMm3": 2e-06,
        "areaAbsoluteToleranceMm2": 3e-06,
        "boundsAbsoluteToleranceMm": 1e-06,
        "probes": [
          {
            "id": "common-g1/inside",
            "pointMm": [
              0.25,
              0.75,
              0.5
            ],
            "classification": "Inside"
          },
          {
            "id": "common-g1/removed-half",
            "pointMm": [
              0.75,
              0.25,
              0.5
            ],
            "classification": "Outside"
          },
          {
            "id": "common-g1/diagonal",
            "pointMm": [
              0.5,
              0.5,
              0.5
            ],
            "classification": "Boundary"
          },
          {
            "id": "common-g1/outside-cap",
            "pointMm": [
              0.25,
              0.75,
              1.25
            ],
            "classification": "Outside"
          }
        ],
        "derivation": "The cube intersects the original rotated side-prism in a triangular prism over (0,0),(1,1),(0,1), height 1. V=0.5; S=2*0.5+(1+1+sqrt(2))*1=3+sqrt(2). The triangle is an oracle, never a constructed operand."
      }
    },
