    {
      "id": "common-e1",
      "upstreamPath": "tests/boolean/bcommon_simple/E1",
      "upstreamUrl": "https://github.com/Open-Cascade-SAS/OCCT/blob/3d097a0328e71b826377d4814ab05ec3c3d23871/tests/boolean/bcommon_simple/E1",
      "originalSource": "upstream/tests/boolean/bcommon_simple/E1",
      "originalSourceSha256": "5fcb21b62035fe8ce9c7c7021802ad9dc3e1c1d5399f010dc313842cec45471a",
      "source": "adapted/common-e1.fs",
      "sourceSha256": "6d6106f397a4780ea8c69e3cd57c9e54ed4576c58a8a09aa0f82479395c60cdf",
      "feature": "main",
      "operation": "INTERSECTION",
      "modifications": "Original planar vertices/edges/wire/mkplane become skPolyline/skSolve on the same plane and opExtrude with the same sweep; no operand replacement. One original unit is one millimeter. ",
      "originalOracles": {
        "areaCommand": "checkprops result -s 4",
        "areaMm2": 4.0,
        "areaAbsoluteToleranceMm2": 5e-06,
        "comparisonPolicy": "Retain the printed upstream area value; local absolute tolerance covers its last printed decimal. This does not run DRAW checkprops.",
        "viewCheck": "Not executed: DRAW checkview screenshot, display framing and image output are outside this numeric adaptation."
      },
      "expected": {
        "solids": 1,
        "volumeMm3": 0.5,
        "areaMm2": 4,
        "boundsMm": {
          "min": [
            0,
            0,
            0
          ],
          "max": [
            1,
            0.5,
            1
          ]
        },
        "volumeAbsoluteToleranceMm3": 2e-06,
        "areaAbsoluteToleranceMm2": 3e-06,
        "boundsAbsoluteToleranceMm": 1e-06,
        "probes": [
          {
            "id": "common-e1/inside",
            "pointMm": [
              0.5,
              0.25,
              0.5
            ],
            "classification": "Inside"
          },
          {
            "id": "common-e1/removed-half",
            "pointMm": [
              0.5,
              0.75,
              0.5
            ],
            "classification": "Outside"
          },
          {
            "id": "common-e1/cut-face",
            "pointMm": [
              0.5,
              0.5,
              0.5
            ],
            "classification": "Boundary"
          },
          {
            "id": "common-e1/outside-cap",
            "pointMm": [
              0.5,
              0.25,
              1.25
            ],
            "classification": "Outside"
          }
        ],
        "derivation": "The second prism [0,1] x [0,0.5] x [0,1] is contained in the first unit cube. V=1*0.5*1=0.5; S=2*(0.5+1+0.5)=4."
      }
    },
    {
      "id": "common-g1",
      "upstreamPath": "tests/boolean/bcommon_simple/G1",
      "upstreamUrl": "https://github.com/Open-Cascade-SAS/OCCT/blob/3d097a0328e71b826377d4814ab05ec3c3d23871/tests/boolean/bcommon_simple/G1",
